---
import registry from "../../sources/unicamp.json";
import { resolveSource, type OfficialSourceRegistry } from "../../scripts/source-registry.ts";

interface Props {
  ids: string[];
}

const { ids } = Astro.props;
const sourceRegistry = registry as OfficialSourceRegistry;
const sources = ids.map((id) => {
  const source = resolveSource(sourceRegistry, id);
  if (!source) throw new Error(`Unknown official source: ${id}`);
  return source;
});
const uniqueSources = [...new Map(sources.map((source) => [source.id, source])).values()];

const authorityLabels: Record<string, string> = {
  normative: "Normativa",
  registry: "Registro oficial",
  operational: "Fonte operacional",
  complementary: "Referência complementar"
};
---

<section aria-labelledby="official-sources-heading" class="official-sources">
  <h2 id="official-sources-heading">Fontes</h2>
  <div class="source-list">
    {uniqueSources.map((source) => (
      <article class="source-row">
        <p class="source-kind">{authorityLabels[source.authority]}</p>
        <h3><a href={source.url}>{source.title}</a></h3>
        <p>{source.provenanceNote}</p>
      </article>
    ))}
  </div>
</section>
