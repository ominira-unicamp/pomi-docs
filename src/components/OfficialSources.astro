---
import registry from "../../sources/unicamp.json";
import type { OfficialSourceRegistry } from "../../scripts/source-registry.ts";

interface Props {
  ids: string[];
}

const { ids } = Astro.props;
const sourceRegistry = registry as OfficialSourceRegistry;
const sources = ids.map((id) => {
  const source = sourceRegistry.sources.find((candidate) => candidate.id === id);
  if (!source) throw new Error(`Unknown official source: ${id}`);
  return source;
});

const authorityLabels: Record<string, string> = {
  normative: "Normativa",
  registry: "Registro oficial",
  operational: "Fonte operacional",
  complementary: "Referência complementar"
};
---

<section aria-labelledby="official-sources-heading">
  <h2 id="official-sources-heading">Fontes oficiais</h2>
  <div class="source-grid">
    {sources.map((source) => (
      <article class="source-card">
        <p class="source-kind">{authorityLabels[source.authority]}</p>
        <h3><a href={source.url}>{source.title}</a></h3>
        <p>{source.issuer}</p>
        <details class="source-details">
          <summary>Proveniência e referências</summary>
          <p>{source.provenanceNote}</p>
          {source.references?.map((reference) => (
            <p><small>{reference.label}{reference.articles?.length ? ` — arts. ${reference.articles.join(", ")}` : ""}</small></p>
          ))}
          <p><small>Verificação documental: {source.lastVerifiedAt}</small></p>
        </details>
      </article>
    ))}
  </div>
</section>
