---
import manifest from "../../.cache/generated/data-domain-manifest.json";
import semantics from "../../semantics/data-api.json";
import registry from "../../sources/unicamp.json";
import type { DomainSemantics } from "../../scripts/semantics.ts";
import type { OfficialSourceRegistry } from "../../scripts/source-registry.ts";

interface Props { name: string; title?: string; headingLevel?: "h2" | "h3" }
const { name, title, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const ItemHeading = headingLevel === "h3" ? "h4" : "h3";
const documented = (semantics as DomainSemantics).enums[name];
if (!documented) throw new Error(`Missing documented enum: ${name}`);
const contract = manifest.concepts[name as keyof typeof manifest.concepts];
if (!contract?.enumValues) throw new Error(`Unknown enum: ${name}`);
const sourceById = new Map(
  (registry as OfficialSourceRegistry).sources.map((source) => [source.id, source])
);
---

<section class="knowledge-section" aria-labelledby={`enum-${name}`}>
  <Heading id={`enum-${name}`}>{title ?? name}</Heading>
  <div class="semantic-grid">
    {contract.enumValues.map((value) => {
      const semantic = documented.values[value];
      if (!semantic) throw new Error(`Missing enum semantics: ${name}.${value}`);
      return (
        <article class="semantic-card">
          <ItemHeading><code>{value}</code></ItemHeading>
          <p><strong>{semantic.label}</strong></p>
          <p>{semantic.description}</p>
          {semantic.sources.map((reference) => {
            const source = sourceById.get(reference.sourceId);
            return source && <p><small>Fonte: <a href={source.url}>{source.title}</a></small></p>;
          })}
        </article>
      );
    })}
  </div>
  {contract.nullable && <p><strong>Quando o valor é <code>null</code>:</strong> {documented.nullMeaning}</p>}
</section>
