---
import manifest from "../../.cache/generated/data-domain-manifest.json";
import semantics from "../../semantics/data-api.json";
import registry from "../../sources/unicamp.json";
import type { DomainSemantics } from "../../scripts/semantics.ts";
import { resolveSource, type OfficialSourceRegistry } from "../../scripts/source-registry.ts";

interface Props { name: string; title?: string; headingLevel?: "h2" | "h3" }
const { name, title, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const ItemHeading = headingLevel === "h3" ? "h4" : "h3";
const documented = (semantics as DomainSemantics).unions[name];
if (!documented) throw new Error(`Missing documented union: ${name}`);
const contract = manifest.concepts[name as keyof typeof manifest.concepts];
if (!contract?.union) throw new Error(`Unknown union: ${name}`);
const sourceRegistry = registry as OfficialSourceRegistry;
---

<section class="knowledge-section" aria-labelledby={`union-${name}`}>
  <Heading id={`union-${name}`}>{title ?? name}</Heading>
  <p>O campo discriminador é <code>{contract.union.discriminator}</code>.</p>
  <div class="semantic-grid">
    {contract.union.variants.map((variant) => {
      const semantic = documented.variants[variant.value];
      if (!semantic) throw new Error(`Missing union semantics: ${name}.${variant.value}`);
      return (
        <article class="semantic-card">
          <ItemHeading><code>{variant.value}</code></ItemHeading>
          <p><strong>{semantic.label}</strong></p>
          <p>{semantic.description}</p>
          <p><small>Schema: <code>{variant.publicName ?? variant.schema}</code></small></p>
          {semantic.sources.map((reference) => {
            const source = resolveSource(sourceRegistry, reference.sourceId);
            return source && <p><small>Fonte: <a href={source.url}>{source.title}</a></small></p>;
          })}
        </article>
      );
    })}
  </div>
</section>
