---
import registry from "../../sources/unicamp.json";
import { resolveSource, type OfficialSourceRegistry } from "../../scripts/source-registry.ts";

interface Props { id: string; label?: string }
const { id, label } = Astro.props;
const source = resolveSource(registry as OfficialSourceRegistry, id);
if (!source) throw new Error(`Unknown official source: ${id}`);
const href = source.instance?.url ?? source.url;
---

<a class="source-ref" href={href} data-source-id={id} title={`${source.issuer}: ${source.title}`}>
  {label ?? source.title}
</a>
