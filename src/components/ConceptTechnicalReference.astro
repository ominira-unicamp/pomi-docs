---
import manifest from "../../.cache/generated/data-domain-manifest.json";
import provenance from "../../provenance/data-api.json";
import type { DomainManifest } from "../../scripts/domain-manifest.ts";
import type { DataProvenance } from "../../scripts/provenance.ts";
import {
  conceptSlug,
  listOperation,
  resolveFieldGroups,
  summarizeFieldOrigins,
  type TechnicalFieldGroup
} from "../../scripts/technical-surface.ts";
import ProgressiveDisclosure from "./ProgressiveDisclosure.astro";

interface Props {
  concept: "Course" | "Catalog" | "CatalogCourse";
  fieldGroups?: TechnicalFieldGroup[];
}

const { concept, fieldGroups } = Astro.props;
const documented = (manifest as DomainManifest).concepts[concept];
if (!documented) throw new Error(`Unknown technical concept: ${concept}`);
const lineage = (provenance as DataProvenance).concepts[concept];
if (!lineage) throw new Error(`Unknown provenance concept: ${concept}`);
const groups = resolveFieldGroups(concept, documented, fieldGroups);
const listing = listOperation(documented);
const slug = conceptSlug(concept);
---

<ProgressiveDisclosure id={`contract-${slug}`} title={`Referência técnica de ${concept}`} meta={`${documented.fields.length} campos`}>
  <p class="generated-note">Contrato e operações gerados do OpenAPI. Filtros gerados de <code>x-pomi-filters</code>.</p>
  <p>Schema <code>{documented.schema}</code>; identidade <code>{documented.identityFields.join(", ") || "não declarada"}</code>.</p>

  <section class="technical-reference-section">
    <h3>Operações</h3>
    <ul class="operation-list">
      {documented.operations.map((operation) => (
        <li><a href={operation.referenceHref}><code>{operation.method} {operation.path}</code></a></li>
      ))}
    </ul>
  </section>

  <section class="technical-reference-section">
    <h3>Campos</h3>
    {groups.map((group) => group.fields.length > 0 && (
      <section class="schema-group">
        {group.title && <h4>{group.title}</h4>}
        <div class="table-wrap">
          <table role="table" tabindex="0">
            <thead role="rowgroup"><tr role="row"><th role="columnheader">Campo</th><th role="columnheader">Tipo</th><th role="columnheader">Presença</th><th role="columnheader">Origem</th><th role="columnheader">Descrição</th></tr></thead>
            <tbody role="rowgroup">
              {group.fields.map((field) => {
                const fieldLineage = lineage.fields[field.name];
                if (!fieldLineage) throw new Error(`Missing provenance for ${concept}.${field.name}`);
                const origins = summarizeFieldOrigins(fieldLineage.lineage.map(({ origin }) => origin));
                return (
                  <tr role="row">
                    <td role="cell" data-label="Campo"><code>{field.name}</code></td>
                    <td role="cell" data-label="Tipo"><code>{field.type}</code>{field.nullable && " ou null"}</td>
                    <td role="cell" data-label="Presença">{field.required ? "Obrigatório" : "Opcional"}</td>
                    <td role="cell" data-label="Origem">{origins.join(" / ")}</td>
                    <td role="cell" data-label="Descrição">{field.description ?? "Sem descrição adicional no contrato."}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    ))}
  </section>

  {listing?.filters && (
    <section id={`filters-${slug}`} class="technical-reference-section">
      <h3>Filtros</h3>
      <p>{listing.filters.fields.length} campos aceitam filtros nesta coleção.</p>
      <div class="table-wrap">
        <table role="table" tabindex="0">
          <thead role="rowgroup"><tr role="row"><th role="columnheader">Campo</th><th role="columnheader">Tipo</th><th role="columnheader">Operadores</th></tr></thead>
          <tbody role="rowgroup">
            {listing.filters.fields.map((field) => (
              <tr role="row">
                <td role="cell" data-label="Campo"><code>{field.path.join(".")}</code></td>
                <td role="cell" data-label="Tipo"><code>{String(field.schema.type ?? "desconhecido")}</code></td>
                <td role="cell" data-label="Operadores">{field.operators.map((operator) => <code>{operator}</code>)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p><a href="/data-api/filtering/">Entenda a sintaxe de filtros e ordenação</a>.</p>
    </section>
  )}

  {listing?.sort && (
    <section id={`sorting-${slug}`} class="technical-reference-section">
      <h3>Ordenação</h3>
      <p>Campos: {listing.sort.fields.map((field) => <code>{field}</code>)}</p>
      <p>Ordem padrão: <code>{listing.sort.default}</code></p>
    </section>
  )}

  {listing?.pagination && (
    <section id={`pagination-${slug}`} class="technical-reference-section">
      <h3>Paginação</h3>
      <dl class="technical-properties">
        <div><dt>Modo padrão</dt><dd><code>{listing.pagination.defaultMode}</code></dd></div>
        <div><dt>Tamanho padrão</dt><dd>{listing.pagination.defaultPageSize}</dd></div>
        {listing.pagination.maxPageSize !== null && <div><dt>Limite máximo</dt><dd>{listing.pagination.maxPageSize}</dd></div>}
        <div><dt>Permite <code>all</code></dt><dd>{listing.pagination.allowAll ? "Sim" : "Não"}</dd></div>
      </dl>
      <p><a href="/data-api/pagination/">Entenda o modelo de paginação</a>.</p>
    </section>
  )}
</ProgressiveDisclosure>
