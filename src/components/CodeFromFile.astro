---
interface Props {
  name: string;
  language?: string;
}

const { name, language = "ts" } = Astro.props;
const examples = import.meta.glob("../../examples/sdk/*.ts", {
  query: "?raw",
  import: "default",
  eager: true
}) as Record<string, string>;
const match = Object.entries(examples).find(([path]) => path.endsWith(`/${name}`));
if (!match) throw new Error(`Unknown SDK example: ${name}`);
const code = match[1];
---

<pre class={`language-${language}`}><code>{code}</code></pre>
