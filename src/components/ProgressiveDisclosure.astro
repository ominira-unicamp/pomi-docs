---
interface Props {
  id?: string;
  title: string;
  meta?: string;
  open?: boolean;
}

const { id, title, meta, open = false } = Astro.props;
---

<details id={id} class="progressive-disclosure" open={open}>
  <summary>
    <span>{title}</span>
    {meta && <small>{meta}</small>}
  </summary>
  <div class="progressive-disclosure__content">
    <slot />
  </div>
</details>
