---
import manifest from "../../.cache/generated/data-domain-manifest.json";
import type { DomainManifest } from "../../scripts/domain-manifest.ts";
import {
  conceptSlug,
  resolveFieldGroups,
  type TechnicalFieldGroup
} from "../../scripts/technical-surface.ts";
import ProgressiveDisclosure from "./ProgressiveDisclosure.astro";

interface Props { names: string[]; fieldGroups?: Record<string, TechnicalFieldGroup[]> }
const { names, fieldGroups = {} } = Astro.props;
const domainManifest = manifest as DomainManifest;
const concepts = names.map((name) => {
  const concept = domainManifest.concepts[name];
  if (!concept) throw new Error(`Unknown documented concept: ${name}`);
  const groups = resolveFieldGroups(name, concept, fieldGroups[name]);
  return { name, slug: conceptSlug(name), groups, ...concept };
});
---

<div class="schema-disclosures">
  {concepts.map((concept) => (
    <ProgressiveDisclosure id={`contract-${concept.slug}`} title={`Contrato de ${concept.name}`} meta={`${concept.fields.length} campos`}>
      <p>Schema <code>{concept.schema}</code>; identidade <code>{concept.identityFields.join(", ") || "não declarada"}</code>.</p>
      {concept.groups.map((group) => group.fields.length > 0 && (
        <section class="schema-group">
          {group.title && <h3>{group.title}</h3>}
          <div class="table-wrap" tabindex="0">
            <table role="table">
              <thead role="rowgroup"><tr role="row"><th role="columnheader">Campo</th><th role="columnheader">Tipo</th><th role="columnheader">Presença</th><th role="columnheader">Descrição</th></tr></thead>
              <tbody role="rowgroup">
                {group.fields.map((field) => (
                  <tr role="row">
                    <td role="cell" data-label="Campo"><code>{field.name}</code></td>
                    <td role="cell" data-label="Tipo"><code>{field.type}</code>{field.nullable && " ou null"}</td>
                    <td role="cell" data-label="Presença">{field.required ? "Obrigatório" : "Opcional"}</td>
                    <td role="cell" data-label="Descrição">{field.description ?? "Sem descrição adicional no contrato."}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))}
      {concept.operations.length > 0 && (
        <ul class="operation-list">
          {concept.operations.map((operation) => (
            <li><a href={operation.referenceHref}><code>{operation.method} {operation.path}</code></a></li>
          ))}
        </ul>
      )}
    </ProgressiveDisclosure>
  ))}
</div>
