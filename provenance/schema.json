{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requiredConcepts", "concepts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requiredConcepts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "concepts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/concept"
      }
    }
  },
  "$defs": {
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "referenceLabels": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "operationalSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "collector", "injection"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "collector": { "type": "string", "minLength": 1 },
        "injection": { "type": "string", "minLength": 1 }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin"],
      "properties": {
        "origin": {
          "enum": [
            "source",
            "normalized",
            "derived",
            "linked",
            "pomi-generated",
            "parsed",
            "aggregated",
            "unspecified"
          ]
        },
        "sourceId": { "type": "string", "minLength": 1 },
        "sourceField": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineage"],
      "properties": {
        "lineage": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lineage" }
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nature",
        "summary",
        "semanticAuthorities",
        "operationalSources",
        "limitations",
        "fields"
      ],
      "properties": {
        "nature": { "enum": ["institutional-concept", "pomi-abstraction"] },
        "summary": { "type": "string", "minLength": 1 },
        "semanticAuthorities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceReference" }
        },
        "operationalSources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/operationalSource" }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/field" }
        }
      }
    }
  }
}
