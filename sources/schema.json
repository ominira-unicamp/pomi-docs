{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "families", "sources"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "priority", "authority", "title", "issuer", "url", "lastVerifiedAt", "concepts", "provenanceNote"],
        "properties": {
          "id": { "type": "string", "pattern": "^UNICAMP_[A-Z0-9_]+$" },
          "priority": { "enum": ["P0", "P1", "P2"] },
          "authority": { "enum": ["normative", "registry", "operational", "complementary"] },
          "title": { "type": "string", "minLength": 1 },
          "issuer": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "lastVerifiedAt": { "type": "string", "format": "date" },
          "concepts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "provenanceNote": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "priority",
          "authority",
          "title",
          "issuer",
          "url",
          "lastVerifiedAt",
          "type",
          "concepts",
          "cadence",
          "access",
          "licenseNote",
          "provenanceNote"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^UNICAMP_[A-Z0-9_]+$" },
          "priority": { "enum": ["P0", "P1", "P2"] },
          "authority": {
            "enum": ["normative", "registry", "operational", "complementary"]
          },
          "title": { "type": "string", "minLength": 1 },
          "issuer": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "landingUrl": { "type": "string", "format": "uri" },
          "publishedAt": { "type": "string", "format": "date" },
          "effectiveAt": { "type": "string", "format": "date" },
          "lastVerifiedAt": { "type": "string", "format": "date" },
          "type": { "type": "string", "minLength": 1 },
          "concepts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "cadence": { "type": "string", "minLength": 1 },
          "access": { "type": "string", "minLength": 1 },
          "licenseNote": { "type": "string", "minLength": 1 },
          "provenanceNote": { "type": "string", "minLength": 1 }
          ,
          "familyId": { "type": "string", "pattern": "^UNICAMP_[A-Z0-9_]+$" },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "catalogYear": { "type": "integer", "minimum": 1900 },
              "coursePrefix": { "type": "string", "minLength": 1 },
              "programCode": { "type": "string", "minLength": 1 },
              "academicPeriod": { "type": "string", "minLength": 1 }
            }
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label"],
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "section": { "type": "string", "minLength": 1 },
                "articles": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "temporalScope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "dimensions"],
            "properties": {
              "type": {
                "enum": [
                  "consolidated-regulation",
                  "annual-series",
                  "catalog-edition",
                  "academic-period",
                  "current-state",
                  "irregular"
                ]
              },
              "dimensions": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
