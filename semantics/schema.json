{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "enums", "unions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "enums": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/semanticSet" }
    },
    "unions": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/unionSet" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "referenceLabel": { "type": "string", "minLength": 1 }
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "description", "sources"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "semanticSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values"],
      "properties": {
        "nullMeaning": { "type": "string", "minLength": 1 },
        "values": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/value" }
        }
      }
    },
    "unionSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discriminator", "variants"],
      "properties": {
        "discriminator": { "type": "string", "minLength": 1 },
        "variants": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/value" }
        }
      }
    }
  }
}
